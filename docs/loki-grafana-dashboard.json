      "description": "Show distribution of flows by Destination Type (WorkloadEndpoint/NetworkSet/etc)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
