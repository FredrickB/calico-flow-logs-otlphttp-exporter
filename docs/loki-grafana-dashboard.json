      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (destType) (\n    count_over_time(\n        ({service_name=\"calico-flow-logs-otlphttp-exporter\"} | json destType=\"Key.destType\" | destType != \"\")[$__auto]\n    )\n)",
          "legendFormat": "{{ destType }}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Flow by Destination Type",
      "type": "piechart"
